# Platform config: comma-separated files, merged left to right. CONFIG (base64 YAML or JSON) is merged last.
CONFIG_PATH=config/example.yaml

# Secrets named in the platform config. The proxy and workers need the CDP key while the `cdp`
# facilitator is enabled: an Ed25519 key in base64, or a P-256 PEM with each newline written as \n.
# README.md, "Apps", shows how to turn the facilitators off for local runs without one.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
SMTP_USERNAME=
SMTP_PASSWORD=

# Postgres and Redis for the apps and `npm run db:migrate`. They carry passwords, so they never go in
# platform config. Match the docker-compose values below.
DATABASE_URL=postgres://servicerouter:change-me@localhost:5432/servicerouter
REDIS_URL=redis://:change-me@localhost:6379

# The secrets key pair (SC-2, S2-D4). The API seals seller secrets with the public key; only the proxy
# holds the private key that opens them. Each PEM goes on one line, with every newline written as \n.
# README.md, "Secrets key pair", has a command that generates a pair and writes both lines.
SECRETS_PUBLIC_KEY=
# The proxy's private keys: one or more PEM keys, one after another, so the pair can rotate
SECRETS_PRIVATE_KEYS=

# The proxies in front of the API and the proxy whose X-Forwarded-For gives the client IP: addresses,
# CIDR ranges, or names such as uniquelocal, comma-separated. Leave it empty locally. Behind Traefik it
# must name Traefik's network, or every client counts as Traefik's address and the per-IP limits
# (signups, unpaid proxy requests) are global.
TRUST_PROXY=

# The proxy's HMAC key for the Servicerouter-Buyer header (PX-15): at least 32 characters, the same on
# every proxy replica.
BUYER_HEADER_KEY=change-me-to-a-random-key-of-32-or-more-characters

# The internal API's shared secret (PA-4): at least 32 characters. Callers send it in x-internal-secret.
# The internal API listens on INTERNAL_PORT, 8082 by default, never behind Traefik.
INTERNAL_API_SECRET=change-me-to-a-random-secret-of-32-or-more-characters

# Ports and HOST have a default per app (README.md, "Apps"), so `npm run dev` runs several apps side by
# side. Set PORT, METRICS_PORT, or HOST only per process, never here.

# Integration and functional tests. The Postgres role must be allowed to create databases: each test
# file gets its own. Each test file also gets its own Redis key and channel prefix.
TEST_DATABASE_URL=postgres://servicerouter:change-me@localhost:5432/servicerouter
TEST_REDIS_URL=redis://:change-me@localhost:6379

# docker-compose interpolation only. The apps don't read these.
POSTGRES__PORT=5432
POSTGRES__USER=servicerouter
POSTGRES__PASSWORD=change-me
POSTGRES__DB=servicerouter
REDIS__PORT=6379
REDIS__PASSWORD=change-me
