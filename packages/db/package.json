{
  "name": "@servicerouter/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, migrations, repositories",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
