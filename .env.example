# Platform config: comma-separated files, merged left to right. CONFIG (base64 YAML or JSON) is merged last.
CONFIG_PATH=config/example.yaml

# Secrets named in the platform config. The proxy and workers need the CDP key while the `cdp`
# facilitator is enabled: an Ed25519 key in base64, or a P-256 PEM with each newline written as \n.
# README.md, "Apps", shows how to turn the facilitators off for local runs without one.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
SMTP_USERNAME=
SMTP_PASSWORD=

# Postgres and Redis for the apps and `npm run db:migrate`. They carry passwords, so they never go in
# platform config. Match the docker-compose values below.
DATABASE_URL=postgres://servicerouter:change-me@localhost:5432/servicerouter
REDIS_URL=redis://:change-me@localhost:6379

# The secrets key pair (SC-2, S2-D4). The API seals seller secrets with the public key; only the proxy
# holds the private key that opens them. Each PEM goes on one line, with every newline written as \n.
# README.md, "Secrets key pair", has a command that generates a pair and writes both lines.
SECRETS_PUBLIC_KEY=
# The proxy's private keys: one or more PEM keys, one after another, so the pair can rotate
SECRETS_PRIVATE_KEYS=

# The proxies in front of the API and the proxy whose X-Forwarded-For gives the client IP: addresses,
# CIDR ranges, or names such as uniquelocal, comma-separated. Leave it empty locally. Behind Traefik it
# must name Traefik's network, or every client counts as Traefik's address and the per-IP limits
# (signups, unpaid proxy requests) are global.
TRUST_PROXY=

# The proxy's HMAC key for the Servicerouter-Buyer header (PX-15): at least 32 characters, the same on
# every proxy replica.
BUYER_HEADER_KEY=change-me-to-a-random-key-of-32-or-more-characters

# MPP (PR-9): the HMAC key that binds every MPP challenge, at least 32 bytes, the same on every proxy
# replica. Generate one with: openssl rand -base64 32. The proxy needs it while MPP is on, as it is in
# config/example.yaml. The Tempo RPC is `mpp.rpcUrl` in platform config (HTTPS, no credentials), the
# chain's public RPC when unset. README.md, "Apps", shows how to turn MPP off for local runs.
MPP_SECRET_KEY=change-me-to-a-random-key-of-32-or-more-bytes

# The internal API's shared secret (PA-4): at least 32 characters. Callers send it in x-internal-secret.
# The internal API listens on INTERNAL_PORT, 8082 by default, never behind Traefik.
INTERNAL_API_SECRET=change-me-to-a-random-secret-of-32-or-more-characters

# The website (packages/web, README.md "Website"). Defaults are the production hosts. Locally, point it at
# the local API and proxy. WEB_MOCKS names what is sample data: the catalog, its agent docs, and sample
# top-up links. A real top-up link and a signed-in account always read the API.
SITE_URL=http://localhost:3000
API_URL=http://localhost:8081
PAY_URL=http://localhost:8080
WEB_MOCKS=catalog,agent-docs,topup
# Browser origins besides `urls.website` that may call the Platform API (PA-7): the local website, for the
# console. Comma-separated origins, such as http://localhost:3000. Production leaves it empty.
CORS_ORIGINS=http://localhost:3000

# Ports and HOST have a default per app (README.md, "Apps"), so `npm run dev` runs several apps side by
# side. Set PORT, METRICS_PORT, or HOST only per process, never here.

# Overrides platform config's logger.level in every app: fatal, error, warn, info, debug, trace, or
# silent. Empty: the config's level, info in config/example.yaml. debug shows every upstream answer and
# every job run.
LOG_LEVEL=

# Integration and functional tests. The Postgres role must be allowed to create databases: each test
# file gets its own. Each test file also gets its own Redis key and channel prefix.
TEST_DATABASE_URL=postgres://servicerouter:change-me@localhost:5432/servicerouter
TEST_REDIS_URL=redis://:change-me@localhost:6379

# Blockfrost: the Cardano facilitator's chain access, with `docker compose --profile cardano up -d`, and the
# workers' deposit watcher while `deposits` is on (DP-2). README.md, "x402 on Cardano", has the platform
# config that points the cardano facilitator at it. Use the project ID of the deposits' network.
BLOCKFROST_PROJECT_ID=
# Deposits (DP-1): the HD wallet's account public key, m/1852'/1815'/0', as 128 hex characters. The API
# derives each account's deposit address from it. Make one with `node scripts/deposit-keygen.mjs`, which
# prints the mnemonic to keep offline. Required by the API while `deposits` is on in platform config.
DEPOSIT_ACCOUNT_PUBLIC_KEY=
# Payouts (PO-8): the payout wallet's mnemonic, for the workers only. Its account's first address pays
# sellers. Empty: payouts are off. Never commit one.
PAYOUT_WALLET_MNEMONIC=
# The treasury's EVM balance readers (TR-3): eip155:<chain ID>=<RPC URL>, comma-separated. Optional.
EVM_RPC_URLS=
# The treasury's Solana balance reader (TR-3, P-6). A secret: it may carry a key in its path, such as
# https://sol.nownodes.io/<key>. Empty: Solana's public RPC, rate limited. Never commit a real one.
SOLANA_RPC_URL=
# Payment routing (step 12). The Signer's shared secret, at least 32 characters, for the proxy and the
# Signer. The Base and Tempo hot wallets' keys (0x and 64 hex), for the Signer only: keep them small. One
# key may serve both. Empty: targets on that chain are refused. The proxy finds the Signer and the
# internal API at these URLs; without SIGNER_URL, routed calls pay nobody. Platform config's
# signer.wallets takes the wallets' public addresses, for the balance monitor.
SIGNER_SECRET=change-me-to-a-random-secret-of-32-or-more-characters
SIGNER_BASE_KEY=
SIGNER_TEMPO_KEY=
SIGNER_URL=http://localhost:8083
INTERNAL_API_URL=http://localhost:8082

# docker-compose interpolation only. The apps don't read these.
POSTGRES__PORT=5432
POSTGRES__USER=servicerouter
POSTGRES__PASSWORD=change-me
POSTGRES__DB=servicerouter
REDIS__PORT=6379
REDIS__PASSWORD=change-me
CARDANO_FACILITATOR__PORT=4022
CARDANO_FACILITATOR_DB__PASSWORD=change-me
